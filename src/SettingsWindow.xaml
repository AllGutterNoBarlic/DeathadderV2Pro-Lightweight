<Window x:Class="DeathAdderTool.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeathAdderTool"
        Title="DeathAdder V2 Pro (unofficial)" Width="1140" Height="930" MinWidth="1080" MinHeight="780"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#0C0D15" Foreground="#E6E7F2" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="88" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/DeathAdderTool;component/Theme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Border x:Name="Root" BorderBrush="#262738" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="92"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- ===== Header ===== -->
      <Grid ClipToBounds="True">
        <Viewbox Stretch="Fill" Width="640" HorizontalAlignment="Right" IsHitTestVisible="False">
          <Canvas Width="640" Height="100">
            <Path Data="M40,100 C250,98 380,52 500,0 L640,0 L640,100 Z">
              <Path.Fill>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                  <GradientStop Color="#00302699" Offset="0.15"/>
                  <GradientStop Color="#55372CC8" Offset="0.6"/>
                  <GradientStop Color="#22251C8A" Offset="1"/>
                </LinearGradientBrush>
              </Path.Fill>
            </Path>
            <Path Data="M150,100 C330,92 450,42 550,0" StrokeThickness="2">
              <Path.Stroke>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                  <GradientStop Color="#006D5DFF" Offset="0"/>
                  <GradientStop Color="#D07C6CFF" Offset="0.6"/>
                  <GradientStop Color="#336D5DFF" Offset="1"/>
                </LinearGradientBrush>
              </Path.Stroke>
            </Path>
            <Path Data="M290,100 C420,88 510,44 600,0" Stroke="#3A6D5DFF" StrokeThickness="1"/>
          </Canvas>
        </Viewbox>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="36,4,0,0">
          <local:Glyph Kind="mouse" Width="46" Height="46" Stroke="#E6E7F2" Thickness="1.5"/>
          <Rectangle Width="1" Height="54" Fill="#3A3C55" Margin="24,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="U N O F F I C I A L" FontSize="11" FontWeight="SemiBold" Foreground="#8F92F7" Margin="2,0,0,0"
                       ToolTip="Not made or endorsed by Razer"/>
            <TextBlock Text="DeathAdder V2 Pro" FontSize="31" FontWeight="SemiBold" Foreground="#F3F4FB" Margin="0,-2,0,0"/>
            <TextBlock Text="M O U S E    U T I L I T Y" FontSize="13" Foreground="{StaticResource Muted}" Margin="2,1,0,0"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0">
          <Button Style="{StaticResource ChromeBtn}" Click="Min_Click" ToolTip="Minimize">
            <local:Glyph Kind="min" Width="18" Height="18" Stroke="#D8DAEC" Thickness="1.5"/>
          </Button>
          <Button Style="{StaticResource ChromeBtn}" Click="Max_Click" ToolTip="Maximize">
            <local:Glyph x:Name="MaxGlyph" Kind="max" Width="16" Height="16" Stroke="#D8DAEC" Thickness="1.5"/>
          </Button>
          <Button Style="{StaticResource ChromeBtn}" Click="Close_Click" ToolTip="Close (keeps running in the tray)">
            <local:Glyph Kind="close" Width="18" Height="18" Stroke="#D8DAEC" Thickness="1.5"/>
          </Button>
        </StackPanel>
      </Grid>

      <!-- ===== Body ===== -->
      <Border Grid.Row="1" Margin="14,0,14,14" CornerRadius="16" Background="#11121C" BorderBrush="#1E1F2F" BorderThickness="1" Padding="18">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="430"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- DPI Settings -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource Tile}"><local:Glyph Kind="crosshair" Width="24" Height="24"/></Border>
                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource H2}" Text="DPI Settings"/>
                  <TextBlock Style="{StaticResource Sub}" Text="Set the current DPI and manage quick presets."/>
                </StackPanel>
              </StackPanel>

              <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="92"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="DPI"/>
                <Border Grid.Column="1" Width="176" Height="46" CornerRadius="8" Background="#0F1019" BorderBrush="{StaticResource Edge}" BorderThickness="1.2">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DpiBox" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="19"
                             VerticalContentAlignment="Center" Padding="10,0" CaretBrush="White" MaxLength="5"/>
                    <Grid Grid.Column="1">
                      <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                      </Grid.RowDefinitions>
                      <Border Grid.RowSpan="2" BorderBrush="{StaticResource Edge}" BorderThickness="1,0,0,0"/>
                      <RepeatButton Style="{StaticResource Spin}" Click="SpinUp_Click" Margin="1,0,0,0">
                        <local:Glyph Kind="spinup" Width="15" Height="15" Stroke="#D8DAEC" Thickness="2"/>
                      </RepeatButton>
                      <RepeatButton Grid.Row="1" Style="{StaticResource Spin}" Click="SpinDown_Click" Margin="1,0,0,0">
                        <local:Glyph Kind="spindown" Width="15" Height="15" Stroke="#D8DAEC" Thickness="2"/>
                      </RepeatButton>
                    </Grid>
                  </Grid>
                </Border>
                <Button Grid.Column="2" Style="{StaticResource Primary}" Width="160" Margin="22,0,0,0" Click="Apply_Click">
                  <StackPanel Orientation="Horizontal">
                    <local:Glyph Kind="check" Width="20" Height="20" Stroke="White" Thickness="2.4"/>
                    <TextBlock Text="Apply" Margin="10,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </Grid>

              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="92"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="Presets" VerticalAlignment="Top" Margin="0,8,0,0"/>
                <WrapPanel x:Name="PresetPanel" Grid.Column="1"/>
              </Grid>

              <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,6,0,14"/>

              <CheckBox x:Name="RemapBox" Style="{StaticResource Switch}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Use the two DPI buttons for macros" FontSize="16" FontWeight="SemiBold" Foreground="#EDEEF8" VerticalAlignment="Center"/>
                  <TextBlock Text="(written to the mouse when you Save)" Foreground="{StaticResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </CheckBox>
            </StackPanel>
          </Border>

          <!-- DPI Button Macros -->
          <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource Tile}"><local:Glyph Kind="layers" Width="24" Height="24"/></Border>
                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource H2}" Text="DPI Button Macros"/>
                  <TextBlock Style="{StaticResource Sub}" Text="Assign macro commands to the DPI up and DPI down buttons."/>
                </StackPanel>
              </StackPanel>

              <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="12"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource MacroRow}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="200"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Style="{StaticResource Tile}" Width="40" Height="40" CornerRadius="9"><local:Glyph Kind="up" Width="20" Height="20" Thickness="2"/></Border>
                      <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Top DPI Button" FontSize="16" FontWeight="SemiBold" Foreground="#EDEEF8"/>
                        <TextBlock Style="{StaticResource Sub}" Text="(normally DPI up)"/>
                      </StackPanel>
                    </StackPanel>
                    <TextBox x:Name="UpBox" Grid.Column="1" Style="{StaticResource Code}" MinHeight="64"/>
                  </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource MacroRow}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="200"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Style="{StaticResource Tile}" Width="40" Height="40" CornerRadius="9"><local:Glyph Kind="down" Width="20" Height="20" Thickness="2"/></Border>
                      <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Bottom DPI Button" FontSize="16" FontWeight="SemiBold" Foreground="#EDEEF8"/>
                        <TextBlock Style="{StaticResource Sub}" Text="(normally DPI down)"/>
                      </StackPanel>
                    </StackPanel>
                    <TextBox x:Name="DownBox" Grid.Column="1" Style="{StaticResource Code}" MinHeight="64"/>
                  </Grid>
                </Border>
              </Grid>
            </Grid>
          </Border>

          <!-- Command Reference -->
          <Border Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource Card}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource Tile}"><local:Glyph Kind="book" Width="24" Height="24"/></Border>
                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource H2}" Text="Command Reference"/>
                  <TextBlock Style="{StaticResource Sub}" Text="Macro syntax and common commands."/>
                </StackPanel>
              </StackPanel>
              <Border Background="#22243A" CornerRadius="9" Padding="14,9" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal">
                  <local:Glyph Kind="syntax" Width="22" Height="22"/>
                  <TextBlock Text="Syntax" FontWeight="SemiBold" FontSize="16" Margin="12,0,0,0" VerticalAlignment="Center"/>
                  <TextBlock Text="One command per line." Margin="30,0,0,0" Foreground="#B5B7CE" VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
              <StackPanel x:Name="RefPanel"/>
            </StackPanel>
          </Border>
          <Button Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource Secondary}" VerticalAlignment="Bottom" Margin="22,0,22,18"
                  Click="AllCommands_Click" AutomationProperties.Name="View all commands" ToolTip="Every command, key name and example. Click one to insert it.">
            <StackPanel Orientation="Horizontal">
              <local:Glyph Kind="list" Width="20" Height="20" Stroke="#E6E7F2"/>
              <TextBlock Text="View all commands" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <!-- Footer -->
          <Border Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="22,12" Margin="0,14,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button Style="{StaticResource Primary}" Width="190" Click="Save_Click">
                <StackPanel Orientation="Horizontal">
                  <local:Glyph Kind="save" Width="21" Height="21" Stroke="White" Thickness="2"/>
                  <TextBlock x:Name="SaveText" Text="Save" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Grid.Column="1" Style="{StaticResource Secondary}" Width="170" Margin="18,0,0,0" Click="Test_Click"
                      ToolTip="Runs the macro you last clicked into, after 1.5 seconds">
                <StackPanel Orientation="Horizontal">
                  <local:Glyph Kind="play" Width="19" Height="19" Stroke="#E6E7F2" Thickness="1.8"/>
                  <TextBlock x:Name="TestText" Text="Test" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Rectangle Grid.Column="2" Style="{StaticResource VSep}"/>
              <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:Glyph x:Name="ConnGlyph" Kind="link" Width="24" Height="24" Stroke="#8F92F7"/>
                <TextBlock x:Name="ConnText" Text="Connecting…" FontSize="16" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <Rectangle Style="{StaticResource VSep}"/>
                <local:Glyph Kind="crosshair" Width="24" Height="24" Stroke="#E6E7F2"/>
                <TextBlock Text="DPI" FontSize="16" Foreground="#C9CBE0" Margin="12,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="DpiText" Text="—" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <Rectangle Style="{StaticResource VSep}"/>
                <Grid Width="34" Height="17" VerticalAlignment="Center">
                  <Border Width="30" HorizontalAlignment="Left" BorderBrush="#C9CBF2" BorderThickness="1.6" CornerRadius="3.5" Padding="2">
                    <Border x:Name="BattFill" HorizontalAlignment="Left" Width="0" CornerRadius="1.5" Background="{StaticResource Accent}"/>
                  </Border>
                  <Border Width="3" Height="7" HorizontalAlignment="Right" Background="#C9CBF2" CornerRadius="1"/>
                </Grid>
                <TextBlock Text="Battery" FontSize="16" Foreground="#C9CBE0" Margin="12,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="BattText" Text="—" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
