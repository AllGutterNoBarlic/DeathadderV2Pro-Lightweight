<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>DeathAdderTool</AssemblyName>
    <RootNamespace>DeathAdderTool</RootNamespace>
    <ApplicationIcon>..\assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- File properties shown by Windows / used by reputation systems. -->
    <Version>1.0.0</Version>
    <Product>DeathAdderTool (unofficial)</Product>
    <AssemblyTitle>DeathAdderTool - unofficial DeathAdder V2 Pro utility</AssemblyTitle>
    <Company>DeathAdderTool contributors</Company>
    <Authors>DeathAdderTool contributors</Authors>
    <Description>Unofficial DPI control and DPI-button macros for the Razer DeathAdder V2 Pro. Not affiliated with Razer.</Description>
    <Copyright>Copyright (c) 2026 DeathAdderTool contributors. MIT License.</Copyright>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Plain files (exe + dll), never a self-extracting single-file bundle: bundles look "packed" to antivirus heuristics.
         Override with -p:SelfContained=true to include the .NET runtime (used by the installer). -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Memory: no background GC thread, no profile-guided re-JIT; the app is idle almost all the time. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compact the heap more eagerly instead of growing it (0-9). -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\assets\app.ico" LogicalName="app.ico" />
  </ItemGroup>
</Project>
