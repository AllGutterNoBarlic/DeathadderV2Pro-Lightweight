<Window x:Class="DeathAdderTool.AllCommandsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeathAdderTool"
        Title="All Commands" Width="820" Height="820" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#0C0D15" Foreground="#E6E7F2" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="84" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/DeathAdderTool;component/Theme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Border BorderBrush="#262738" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="84"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Header -->
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0,0,0">
        <Border Style="{StaticResource Tile}"><local:Glyph Kind="list" Width="24" Height="24"/></Border>
        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource H2}" Text="All Commands"/>
          <TextBlock x:Name="SubText" Style="{StaticResource Sub}" Text="Click any command to add it to your macro."/>
        </StackPanel>
      </StackPanel>
      <Button Style="{StaticResource ChromeBtn}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0" Click="Close_Click" ToolTip="Close">
        <local:Glyph Kind="close" Width="18" Height="18" Stroke="#D8DAEC" Thickness="1.5"/>
      </Button>

      <!-- Search + target -->
      <Grid Grid.Row="1" Margin="26,4,26,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid>
          <TextBox x:Name="SearchBox" Style="{StaticResource Search}" Padding="36,0,10,0"/>
          <local:Glyph Kind="search" Width="18" Height="18" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/>
          <TextBlock x:Name="SearchHint" Text="Search commands and keys…" Foreground="#6E7090" FontSize="15"
                     VerticalAlignment="Center" Margin="40,0,0,0" IsHitTestVisible="False"/>
        </Grid>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Add to" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <Button x:Name="TopTarget" Style="{StaticResource Pill}" Content="Top button" Margin="0,0,8,0" Click="TopTarget_Click"/>
          <Button x:Name="BottomTarget" Style="{StaticResource Pill}" Content="Bottom button" Margin="0" Click="BottomTarget_Click"/>
        </StackPanel>
      </Grid>

      <!-- Sections -->
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="26,0,18,0" Margin="0,0,8,0">
        <StackPanel x:Name="SectionPanel" Margin="0,0,0,12"/>
      </ScrollViewer>

      <!-- Status -->
      <Border Grid.Row="3" Background="#11121C" BorderBrush="#1E1F2F" BorderThickness="0,1,0,0" Padding="26,12">
        <StackPanel Orientation="Horizontal">
          <local:Glyph x:Name="StatusGlyph" Kind="check" Width="18" Height="18" Stroke="#8F92F7" Thickness="2.2" Visibility="Collapsed"/>
          <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"
                     Text="Tip: you can keep this open while editing. Remember to click Save in the main window."/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
